<div class="inner">
	<div class="content">
		<div class="box">			
			{{#ifCond format '==' 'large'}}
				<div class="fl table col4 row12">
					<div class="cell middle">
						<div class="state">								
							<span class="mdi mdi-{{{perception.icon}}} {{{perception.color}}}"></span>
						</div>					
						<div class="capability p5t strong">{{{perception.value}}}</div>	
					</div>
				</div>		
				<div class="fr table col8 row12">
					<div class="cell middle">					
						<div class="p5r">
							<div class="p5b b1b">
								<div class="fl left"><span class="mdi mdi-thermometer size_l"></span> Temperature</div>
								<div class="fr right"><span class="strong">{{{data.measure_temperature.value}}}</span><sup>&deg;</sup></div>
								<div class="clear"></div>
							</div>
							<div class="p5t p5b b1b">
								<div class="fl left"><span class="mdi mdi-water size_l"></span> Relative Humidity</div>
								<div class="fr right"><span class="strong">{{{data.measure_humidity.value}}}</span><inf class="size_xxs">{{{data.measure_humidity.units}}}</inf></div>
								<div class="clear"></div>
							</div>
							<div class="p5t p5b b1b">
								<div class="fl left"><span class="mdi mdi-water size_l"></span> Absolute humidity</div>
								<div class="fr right"><span class="strong">{{{absolute_humidity.value}}}</span> <inf class="size_xxs">{{{absolute_humidity.units}}}</inf></div>
								<div class="clear"></div>
							</div>
							<div class="p5t p5b b1b">
								<div class="fl left"><span class="mdi mdi-water-thermometer size_l"></span> Dew point</div>
								<div class="fr right"><span class="strong">{{{dew_point.value}}}</span><sup>{{{dew_point.units}}}</sup></div>															
								<div class="clear"></div>
							</div>
							<div class="p5t">
								<div class="fl left"><span class="mdi mdi-thermometer-water size_l"></span> Humidex</div>
								<div class="fr right"><span class="strong">{{{humidex.value}}}</span><sup>{{{humidex.units}}}</sup></div>															
								<div class="clear"></div>
							</div>
						</div>
					</div>
				</div>													
			{{else}}	
				{{#ifCond format '==' 'medium'}}
					<div class="fl table col4 row12">
						<div class="cell middle">
							<div class="state">								
								<span class="mdi mdi-{{{perception.icon}}} {{{perception.color}}}"></span> 						
							</div>					
							<div class="capability strong">{{{perception.value}}}</div>	
						</div>
					</div>		
					<div class="fr table col8 row12">
						<div class="cell middle">					
							<div class="p5r">
								<div class="p5b b1b">
									<div class="fl left"><span class="mdi mdi-thermometer size_l"></span> Temperature</div>
									<div class="fr right"><span class="strong">{{{data.measure_temperature.value}}}</span><sup>&deg;</sup></div>
									<div class="clear"></div>
								</div>
								<div class="p5b b1b">
									<div class="fl left"><span class="mdi mdi-water size_l"></span> Relative humidity</div>
									<div class="fr right"><span class="strong">{{{data.measure_humidity.value}}}</span><inf class="size_xxs">{{{data.measure_humidity.units}}}</inf></div>
									<div class="clear"></div>
								</div>			
								<div class="p5b b1b">
									<div class="fl left"><span class="mdi mdi-water size_l"></span> Absolute humidity</div>
									<div class="fr right"><span class="strong">{{{absolute_humidity.value}}}</span> <inf class="size_xxs">{{{absolute_humidity.units}}}</inf></div>
									<div class="clear"></div>
								</div>					
							</div>
						</div>
					</div>				
				{{else}}		
					<div class="fl table col12 row12">
						<div class="cell middle">
							<div class="state">
								<span class="mdi mdi-{{{perception.icon}}} {{{perception.color}}}"></span> 						
							</div>					
							<div class="capability strong">{{{perception.value}}}</div>	
						</div>
					</div>
				{{/ifCond}}
				<div class="clear"></div>
			{{/ifCond}}
		</div>	
		{{#ifCond widget.hidename '==' 0}}<div class="name">{{{name}}}</div>{{/ifCond}}
		{{#ifCond widget.hideupdatetime '==' 0}}<div class="update">{{{update}}}</div>{{/ifCond}}
		{{#if data.measure_battery}}<div class="battery"><span class="mdi mdi-battery{{#ifCond data.measure_battery.value '<' 10}}-outline color_red{{else}}{{#ifCond data.measure_battery.value '>' 70}} color_green{{else}}-50 color_orange{{/ifCond}}{{/ifCond}} mdi-rotate-270"></span></div>{{/if}}	
		<div class="mask"><span class="mdi mdi-dots-circle mdi-spin"></span></div>
		<div class="locked{{#ifCond widget.locked '==' 0}} hide{{/ifCond}}"><span class="mdi mdi-lock"></span></div>
	</div>
</div>	
