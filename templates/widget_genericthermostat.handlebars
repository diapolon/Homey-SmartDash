<div class="inner">
	<div class="content">
		<div class="box">		
			<div class="table col12 row10">
				<div class="cell middle">	
					<div class="value">
						<span class="mdi mdi-home-thermometer-outline size_xl"></span> <span class="size_xxl strong">{{#if measure}}{{{measure.value}}}</span>{{else}}-{{/if}}<sup>&deg;</sup>						
					</div>
				</div>
			</div>
			<div class="abs top-0 right-0 table col3 row10">
				<div class="cell middle">	
					<div class="buttons vertical">					
						<div class="button up" data-op="up"><span class="mdi mdi-chevron-up"></span></div>
						<div><span class="strong">{{#if target}}{{{target.value}}}</span>{{else}}-{{/if}}<sup>&deg;</sup></div>
						<div class="button down" data-op="down"><span class="mdi mdi-chevron-down"></span></div>
					</div>
				</div>
			</div>			
			{{#if buttons}}
				<div class="buttons">					
					{{#each buttons}}<div class="button {{#if active}}active {{/if}}{{{value}}}" data-op="{{{value}}}"><span class="mdi mdi-{{{icon}}}"></span></div>{{/each}}
				</div>
			{{/if}}			
		</div>	
		{{#ifCond widget.hidename '==' 0}}<div class="name">{{{name}}}</div>{{/ifCond}}
		{{#if data.measure_battery}}<div class="battery"><span class="mdi mdi-battery{{#ifCond data.measure_battery.value '<' 10}}-outline color_red{{else}}{{#ifCond data.measure_battery.value '>' 90}} color_green{{else}}-50 color_orange{{/ifCond}}{{/ifCond}} mdi-rotate-270"></span></div>{{/if}}	
		<div class="mask"><span class="mdi mdi-dots-circle mdi-spin"></span></div>
		<div class="locked{{#ifCond widget.locked '==' 0}} hide{{/ifCond}}"><span class="mdi mdi-lock"></span></div>
	</div>
</div>
