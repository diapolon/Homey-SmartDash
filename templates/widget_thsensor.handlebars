<div class="inner">
	<div class="content">
		<div class="box f">
			{{#ifCond format '==' '0x0'}}
				<div class="flex c col12 row12">
					<div class="value">
						<div class="p2b"><span class="size_xs strong">{{{data.measure_temperature.value}}}</span><span class="size_xxs">{{{data.measure_temperature.units}}}</span></div>
						<span class="size_xs strong">{{{data.measure_humidity.value}}}</span><span class="size_xxs">{{{data.measure_humidity.units}}}</span>
					</div>	
				</div>		
			{{else}}
				<div class="fl flex c col6 row12">
					<div class="value"><span class="strong">{{{data.measure_temperature.value}}}</span><span class="size_xs">{{{data.measure_temperature.units}}}</span></div>	
				</div>		
				<div class="fr flex c col6 row12">
					<div class="value"><span class="strong">{{{data.measure_humidity.value}}}</span><span class="size_xs">{{{data.measure_humidity.units}}}</span></div>
				</div>				
			{{/ifCond}}
			<div class="clear"></div>
		</div>	
		{{#ifCond widget.hidename '==' 0}}<div class="name">{{{name}}}</div>{{/ifCond}}
		{{#ifCond widget.hideupdatetime '==' 0}}<div class="update">{{{update}}}</div>{{/ifCond}}
		{{#if data.measure_battery}}<div class="battery"><span class="mdi mdi-battery{{#ifCond data.measure_battery.value '<' 10}}-outline color_red{{else}}{{#ifCond data.measure_battery.value '>' 70}} color_green{{else}}-50 color_orange{{/ifCond}}{{/ifCond}} mdi-rotate-270"></span></div>{{/if}}	
		<div class="mask"><span class="mdi mdi-dots-circle mdi-spin"></span></div>
		<div class="locked{{#ifCond widget.locked '==' 0}} hide{{/ifCond}}"><span class="mdi mdi-lock"></span></div>
	</div>
</div>